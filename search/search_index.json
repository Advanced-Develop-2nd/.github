{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u904b\u7528\u30ac\u30a4\u30c9\u30e9\u30a4\u30f3 Home","text":"<p>\u672c\u30ac\u30a4\u30c9\u306e\u76ee\u7684</p> <p>\u672c\u30ac\u30a4\u30c9\u306f\u3001AZAPA\u30a8\u30f3\u30b8\u30cb\u30a2\u30ea\u30f3\u30b0 \u5148\u9032\u958b\u767a\u90e8\u9580 \u7b2c\uff12\u30bb\u30af\u30b7\u30e7\u30f3\u306eGitHub\u904b\u7528\u30fb\u958b\u767a\u30fb\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u7ba1\u7406\u306e\u6a19\u6e96\u3092\u793a\u3057\u307e\u3059\u3002</p>"},{"location":"#_1","title":"\u5168\u4f53\u50cf","text":"<pre><code>flowchart TD\n    Potal[Project Portal]\n    App1[App\u30ea\u30dd\u30b8\u30c8\u30ea1]\n    App2[App\u30ea\u30dd\u30b8\u30c8\u30ea2]\n\n    subgraph \"Portal+App\u9023\u643a\u578b\u904b\u7528\"\n        App1 --&gt;|subtree\u9023\u643a| Potal\n        App2 --&gt;|subtree\u9023\u643a| Potal\n    end\n\n    subgraph \"App\u5358\u4f53\u904b\u7528\"\n        Standalone[App\u5358\u4f53\u30ea\u30dd\u30b8\u30c8\u30ea]\n    end</code></pre> <p>\u904b\u7528\u30d1\u30bf\u30fc\u30f3</p> <ul> <li>Portal+App\u9023\u643a\u578b\u904b\u7528</li> <li>App\u5358\u4f53\u904b\u7528</li> </ul>"},{"location":"#_2","title":"\u76ee\u6b21","text":"<ul> <li>\u7ba1\u7406\u8005\u30ac\u30a4\u30c9</li> <li>\u958b\u767a\u8005\u30ac\u30a4\u30c9</li> <li>\u30c4\u30fc\u30eb\u4ed5\u69d8</li> <li>\u30a2\u30d7\u30ea\u5358\u4f53\u904b\u7528\u30ac\u30a4\u30c9</li> </ul> <p>\u5404\u7ae0\u306e\u8a73\u7d30\u306f\u4e0a\u8a18\u30ea\u30f3\u30af\u5148\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"#home_1","title":"\u904b\u7528\u30ac\u30a4\u30c9\u30e9\u30a4\u30f3 Home","text":""},{"location":"#_3","title":"\ud83c\udfaf \u76ee\u7684","text":"<p>\u672c\u7d44\u7e54\u3067\u306f\u3001\u300cDocs as Code (\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u3082\u30b3\u30fc\u30c9\u3067\u3042\u308b)\u300d\u3092\u63b2\u3052\u3001 \u30bd\u30fc\u30b9\u30b3\u30fc\u30c9\u3068\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u306e\u5b8c\u5168\u4e00\u81f4\u3092\u76ee\u6307\u3057\u307e\u3059\u3002 GitHub Actions \u3068 Git Subtree \u3092\u6d3b\u7528\u3057\u305f\u81ea\u52d5\u9023\u643a\u30b7\u30b9\u30c6\u30e0\u306b\u3088\u308a\u3001\u5c5e\u4eba\u5316\u3092\u6392\u9664\u3057\u3001\u5e38\u306b\u6700\u65b0\u306e\u30ca\u30ec\u30c3\u30b8\u304c\u5171\u6709\u3055\u308c\u308b\u72b6\u614b\u3092\u4fdd\u3061\u307e\u3059\u3002  </p>"},{"location":"#_4","title":"\ud83c\udfd7 \u30b7\u30b9\u30c6\u30e0\u30a2\u30fc\u30ad\u30c6\u30af\u30c1\u30e3","text":"<p>\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3054\u3068\u306b\u4ee5\u4e0b\u306e\u300c\u89aa\u5b50\u69cb\u6210\u300d\u3092\u3068\u308a\u307e\u3059\u3002</p> \u7a2e\u985e \u547d\u540d\u898f\u5247 \u5f79\u5272 Portal (\u89aa) <code>&lt;Project&gt;_portal</code> \u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u7d71\u5408\u3001\u5168\u4f53\u9032\u6357\u7ba1\u7406\u3001Wiki App (\u5b50) <code>&lt;SpecificApp&gt;_&lt;Language&gt;</code> \u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u30bd\u30fc\u30b9\u30b3\u30fc\u30c9\u3001\u8a73\u7d30\u4ed5\u69d8\u66f8"},{"location":"#_5","title":"\u81ea\u52d5\u9023\u643a\u30d5\u30ed\u30fc","text":"<ol> <li>\u958b\u767a: \u5b50\u30ea\u30dd\u30b8\u30c8\u30ea\u3067\u30b3\u30fc\u30c9\u3068 <code>docs/</code> \u3092\u4fee\u6b63\u3057\u3066Push\u3002</li> <li>\u901a\u77e5: GitHub Actions \u3067\u89aa\u30ea\u30dd\u30b8\u30c8\u30ea\u3078\u66f4\u65b0\u3092\u901a\u77e5\u3002</li> <li>\u540c\u671f: \u89aa\u30ea\u30dd\u30b8\u30c8\u30ea\u304c\u81ea\u52d5\u3067 <code>git subtree pull</code> \u3092\u5b9f\u884c\u3002</li> <li>\u7d71\u5408: \u89aa\u30ea\u30dd\u30b8\u30c8\u30ea\u306b\u7d71\u5408PR\u304c\u4f5c\u6210\u3055\u308c\u308b\u3002</li> </ol>"},{"location":"#mobilityops","title":"\ud83d\ude80 \u6700\u65b0\u30d7\u30ed\u30b8\u30a7\u30af\u30c8: MobilityOps","text":"<p>coming soon...</p>"},{"location":"admin/","title":"\u7ba1\u7406\u8005\u30ac\u30a4\u30c9","text":""},{"location":"admin/#1","title":"1. \u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u7acb\u3061\u4e0a\u3052\u624b\u9806","text":"<p>\u91cd\u8981</p> <ul> <li>\u3059\u3079\u3066\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u306f\u81ea\u52d5\u5316\u30b9\u30af\u30ea\u30d7\u30c8\u3067\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002</li> <li>\u624b\u52d5\u3067\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u4f5c\u6210\u3084Subtree\u30b3\u30de\u30f3\u30c9\u306e\u76f4\u63a5\u4f7f\u7528\u306f\u7981\u6b62\u3067\u3059\u3002</li> <li>\u4e8b\u524d\u306b tools/.secret_pat \u306b\u7ba1\u7406\u8005\u6a29\u9650\u3092\u6301\u3064GitHub PAT\u3092\u8a2d\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002</li> </ul> Portal\u65b0\u898f\u4f5c\u6210App\u8ffd\u52a0App\u5358\u4f53\u65b0\u898f\u4f5c\u6210 <pre><code>./tools/setup_portal.sh &lt;Portal\u540d&gt;\n</code></pre> <pre><code>./tools/add_app.sh &lt;Portal\u540d&gt; &lt;App\u540d&gt;\n</code></pre> <pre><code>./tools/setup_app.sh &lt;App\u540d&gt;\n</code></pre>"},{"location":"admin/#2","title":"2. \u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u7ba1\u7406\u30fb\u66f4\u65b0","text":"<p>\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u30ea\u30dd\u30b8\u30c8\u30ea</p> <ul> <li>temp_app, temp_portal \u306e\u69cb\u6210\u3068\u904b\u7528</li> <li>\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u306e\u66f4\u65b0\u30fb\u54c1\u8cea\u62c5\u4fdd\u30d5\u30ed\u30fc</li> </ul>"},{"location":"admin/#3-cicdsecret","title":"3. CI/CD\u30fb\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30fbSecret\u7ba1\u7406","text":"<p>\u8a2d\u8a08\u4f8b\u30fb\u30dd\u30a4\u30f3\u30c8</p> <ul> <li>GitHub Actions\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u8a2d\u8a08\u4f8b</li> <li>\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30b9\u30ad\u30e3\u30f3\u30fbSecret\u7ba1\u7406\u306e\u30dd\u30a4\u30f3\u30c8</li> </ul>"},{"location":"admin/#4","title":"4. \u30c4\u30fc\u30eb\u5229\u7528","text":"\u30b9\u30af\u30ea\u30d7\u30c8 \u6982\u8981 setup_portal.sh Portal\u30ea\u30dd\u30b8\u30c8\u30ea\u65b0\u898f\u4f5c\u6210 add_app.sh Portal\u30ea\u30dd\u30b8\u30c8\u30ea\u3078\u306eApp\u8ffd\u52a0 setup_app.sh App\u5358\u4f53\u30ea\u30dd\u30b8\u30c8\u30ea\u65b0\u898f\u4f5c\u6210 <p>\u8a73\u7d30\u306a\u624b\u9806\u3084\u6ce8\u610f\u70b9\u306f\u3001\u5404\u30b9\u30af\u30ea\u30d7\u30c8\u3084\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u30ea\u30dd\u30b8\u30c8\u30eaREADME\u3082\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"admin/#_2","title":"\u4ed8\u9332: \u6e96\u5099\u30fb\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0","text":""},{"location":"admin/#pat","title":"PAT\u306e\u6e96\u5099","text":"<p>PAT\u306e\u6e96\u5099</p> <ol> <li>\u7ba1\u7406\u30ea\u30dd\u30b8\u30c8\u30ea (<code>.github</code>) \u3092\u30ed\u30fc\u30ab\u30eb\u306bClone</li> <li><code>tools/.secret_pat</code> \u30d5\u30a1\u30a4\u30eb\u3092\u4f5c\u6210\u3057\u3001\u7ba1\u7406\u8005\u6a29\u9650\u3092\u6301\u3064 GitHub PAT (repo, workflow) \u3092\u8a18\u8ff0\u3057\u3066\u4fdd\u5b58\uff08Git\u7ba1\u7406\u5916\u30d5\u30a1\u30a4\u30eb\u306e\u305f\u3081\u5b89\u5168\uff09</li> </ol>"},{"location":"admin/#_3","title":"\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0","text":"<p>\u8a8d\u8a3c\u30a8\u30e9\u30fc</p> <ul> <li><code>gh auth login</code> \u306e\u518d\u5b9f\u884c\u3001\u307e\u305f\u306f <code>.secret_pat</code> \u306e\u66f4\u65b0\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</li> </ul> <p>Subtree\u7af6\u5408</p> <ul> <li>\u89aa\u30ea\u30dd\u30b8\u30c8\u30ea\u5074\u3067\u76f4\u63a5 <code>apps/</code> \u914d\u4e0b\u3092\u7de8\u96c6\u3057\u3066\u3057\u307e\u3063\u305f\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u539f\u5247\u3001\u89aa\u3067\u306e\u7de8\u96c6\u306f\u7981\u6b62\u3067\u3059\u3002</li> </ul>"},{"location":"app_standalone/","title":"\u30a2\u30d7\u30ea\u5358\u4f53\u904b\u7528\u30ac\u30a4\u30c9","text":""},{"location":"app_standalone/#_2","title":"\u6982\u8981","text":"<p>\u672c\u30ac\u30a4\u30c9\u306e\u5bfe\u8c61</p> <p>Portal\u30ea\u30dd\u30b8\u30c8\